# Local development defaults for the shared root env surface.
# Use local-only files for real secrets if this file is kept in git.

# Optional Next.js state snapshot persistence
DATABASE_URL=
DATABASE_SSL=true
NEXT_PUBLIC_FORCE_MOCK_MODE=false
# Private child media storage (Vercel Blob private store)
BLOB_READ_WRITE_TOKEN=

# Minimal auth session and default passwords (MVP)
AUTH_SESSION_SECRET=
AUTH_REGISTER_ENABLED=true
AUTH_DEFAULT_PASSWORD=123456
AUTH_PASSWORD_U_ADMIN=
AUTH_PASSWORD_U_TEACHER=
AUTH_PASSWORD_U_TEACHER2=
AUTH_PASSWORD_U_PARENT=

# 统一 MaaS（Next.js 与 FastAPI 使用相同私有运行时配置）。
# maas 优先于下方旧供应商；文字、识图和 OCR 均使用 AI_TEXT_MODEL，密钥仅在运行时注入。
AI_PROVIDER=maas
AI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_API_KEY=
AI_TEXT_MODEL=ZHIPU/GLM-5.3-Flash
AI_IMAGE_MODEL=z-image-turbo
AI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_TTS_MODEL=qwen3-tts-flash
AI_ASR_MODEL=qwen-audio-3.0-asr-flash
AI_ASR_PROTOCOL=native
AI_ASR_ENDPOINT=
AI_TIMEOUT_MS=60000
# 仅验收计费时设为 1；日志只含模型、请求编号和白名单用量，不记录输入或儿童信息。
AI_USAGE_AUDIT=0
AI_IMAGE_ENDPOINT=
AI_IMAGE_PROTOCOL=native
AI_TTS_ENDPOINT=
AI_TTS_PROTOCOL=native
# 旧 DashScope 兼容配置：仅在 AI_PROVIDER 未选 maas/openai-compatible 时生效。
# 如需旧模型，主动取消相应注释；不要重复设置上方的 AI_ASR_MODEL。
DASHSCOPE_API_KEY=
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# AI_VISION_MODEL=qwen3.7-plus
# AI_OCR_MODEL=qwen3.5-ocr
# AI_ASR_MODEL=qwen3-asr-flash
# AI_ASR_PROTOCOL=compatible
# AI_DIET_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_MS=60000
# 旧 Next.js DashScope 绘本图片使用异步任务；MaaS 使用上方 AI_IMAGE_*，忽略此旧选择器。
NEXT_STORYBOOK_IMAGE_PROVIDER=dashscope
STORYBOOK_DASHSCOPE_IMAGE_MODEL=qwen-image-plus
STORYBOOK_DASHSCOPE_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
STORYBOOK_DASHSCOPE_IMAGE_SIZE=1328*1328
STORYBOOK_DASHSCOPE_IMAGE_TIMEOUT_MS=10000
STORYBOOK_DASHSCOPE_WORKSPACE_ID=

# FastAPI backend runtime for local development
APP_NAME=SmartChildcare Agent Brain
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=8000
ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ENABLE_MOCK_PROVIDER=true
# AI_PROVIDER=maas 时，FastAPI 使用 AI_API_KEY/AI_TEXT_MODEL，不依赖 BRAIN_PROVIDER=vivo。
# BRAIN_PROVIDER 仅保留旧供应商兼容；设 mock 也不会覆盖已明确选定的 MaaS。
# 演示/规则路径需 ENABLE_MOCK_PROVIDER=true，正式服务应设为 false。
BRAIN_PROVIDER=mock
BRAIN_TIMEOUT_MS=20000
REQUEST_TIMEOUT_SECONDS=20
PARENT_STORYBOOK_BACKEND_MEDIA_TIMEOUT_MS=45000
# 服务端总预算必须低于浏览器端 75 秒绘本请求超时。
PARENT_STORYBOOK_REQUEST_TIMEOUT_MS=70000

# Leave secrets empty in tracked files.
VIVO_APP_ID=your_vivo_app_id
VIVO_APP_KEY=your_vivo_app_key
VIVO_BASE_URL=https://api-ai.vivo.com.cn
VIVO_LLM_MODEL=Volc-DeepSeek-V3.2
VIVO_OCR_PATH=your_vivo_ocr_path
VIVO_EMBEDDING_MODEL=your_vivo_embedding_model
VIVO_ASR_PACKAGE=your_vivo_asr_package
VIVO_ASR_CLIENT_VERSION=your_vivo_asr_client_version
VIVO_ASR_USER_ID=your_vivo_asr_user_id
VIVO_ASR_ENGINE_ID=your_vivo_asr_engine_id
STORYBOOK_IMAGE_PROVIDER=mock
STORYBOOK_IMAGE_MODEL=Doubao-Seedream-4.5
STORYBOOK_IMAGE_SIZE=2K
STORYBOOK_IMAGE_CONCURRENCY=2
STORYBOOK_IMAGE_BATCH_SIZE=4
STORYBOOK_IMAGE_RETRY_BACKOFF_MS=70000
STORYBOOK_AUDIO_PROVIDER=mock
STORYBOOK_TTS_CONCURRENCY=1
STORYBOOK_TTS_ENGINEID=short_audio_synthesis_jovi
STORYBOOK_TTS_VOICE=yige_child
STORYBOOK_TTS_FALLBACK_ENGINEID=short_audio_synthesis_jovi
STORYBOOK_TTS_FALLBACK_VOICE=vivoHelper
STORYBOOK_TTS_SPEED=45
STORYBOOK_TTS_VOLUME=50
# Optional server-side vivo TTS metadata overrides.
# If left blank, the app uses safe demo defaults and still requires only VIVO_APP_ID,
# VIVO_APP_KEY, and VIVO_BASE_URL for the TTS provider readiness check.
STORYBOOK_TTS_MODEL=
STORYBOOK_TTS_PRODUCT=
STORYBOOK_TTS_PACKAGE=
STORYBOOK_TTS_CLIENT_VERSION=
STORYBOOK_TTS_SYSTEM_VERSION=
STORYBOOK_TTS_SDK_VERSION=
STORYBOOK_TTS_ANDROID_VERSION=

# FastAPI Agent memory hub
MYSQL_URL=
BRAIN_MEMORY_BACKEND=sqlite
BRAIN_MEMORY_SQLITE_PATH=backend/.local/agent-memory.db

# FastAPI brain service bridge
# Backend env lookup priority:
# BRAIN_ENV_FILE > backend/.env.local > repo/.env.local > backend/.env.release > repo/.env.release > backend/.env > repo/.env
# Local dev: prefer an explicit BRAIN_API_BASE_URL. If it is omitted, the Next.js dev proxy now tries APP_PORT, 8000, then 8010.
# Production-like runs do not guess local ports and must set BRAIN_API_BASE_URL explicitly.
# Local dev default: http://127.0.0.1:8000
# Backend staging only, not the competition frontend domain: https://api-staging.smartchildcareagent.cn
BRAIN_API_BASE_URL=http://127.0.0.1:8000
# Internal HMAC service auth for Next.js -> FastAPI brain routes.
# Set the same non-empty value in both Next.js and FastAPI outside development.
BRAIN_INTERNAL_SHARED_SECRET=
# Optional server-side alias for hosted backends; used only when BRAIN_API_BASE_URL and NEXT_PUBLIC_BACKEND_BASE_URL are absent.
BACKEND_BASE_URL=
# Optional debug mirror for surfacing the backend origin in the UI.
# Do not use this as the primary consultation transport.
# The browser should still call Next /api/ai/* routes.
NEXT_PUBLIC_BACKEND_BASE_URL=
BRAIN_API_TIMEOUT_MS=20000

# Optional mini-program integration settings
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_MINI_PROGRAM_PAGE=pages/index/index

# Notification dispatch provider: mock | wechat
NOTIFICATION_PROVIDER=mock

# Cron dispatch protection and batch size
CRON_SECRET=
CRON_DISPATCH_LIMIT_PER_INSTITUTION=100

# Release gate remote checks (optional for local, required for CI remote gate)
RELEASE_BASE_URL=
RELEASE_ADMIN_COOKIE=
RELEASE_REPORT_PATH=./release-report.json
