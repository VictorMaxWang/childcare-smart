# Local development template for the FastAPI backend.
# For Tencent Cloud VPS staging, copy backend/.env.release.example to backend/.env.release
# and inject private credentials only on the server.
APP_NAME=SmartChildcare Agent Brain
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://your-vercel-staging.vercel.app,https://your-frontend.example.com
ENABLE_MOCK_PROVIDER=true
# MaaS 优先于旧 BRAIN_PROVIDER；Next.js 与 FastAPI 应注入相同模型与私有凭据。
AI_PROVIDER=maas
AI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_API_KEY=
AI_TEXT_MODEL=ZHIPU/GLM-5.3-Flash
AI_IMAGE_MODEL=z-image-turbo
AI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_TTS_MODEL=qwen3-tts-flash
AI_ASR_MODEL=qwen-audio-3.0-asr-flash
AI_ASR_PROTOCOL=native
AI_ASR_ENDPOINT=
AI_TIMEOUT_MS=60000
# 仅验收费用时开启脱敏 ai.usage 日志，默认关闭。
AI_USAGE_AUDIT=0
BRAIN_PROVIDER=mock
BRAIN_TIMEOUT_MS=20000
REQUEST_TIMEOUT_SECONDS=30

# 旧 Vivo 兼容配置，仅在没有明确选择 MaaS 时由 BRAIN_PROVIDER=vivo 启用。
VIVO_APP_ID=your_vivo_app_id
VIVO_APP_KEY=your_vivo_app_key
VIVO_BASE_URL=https://api-ai.vivo.com.cn
VIVO_LLM_MODEL=Volc-DeepSeek-V3.2
VIVO_OCR_PATH=your_vivo_ocr_path
VIVO_EMBEDDING_MODEL=your_vivo_embedding_model
STORYBOOK_IMAGE_PROVIDER=mock
STORYBOOK_IMAGE_MODEL=Doubao-Seedream-4.5
STORYBOOK_IMAGE_SIZE=2K
STORYBOOK_IMAGE_CONCURRENCY=2
STORYBOOK_AUDIO_PROVIDER=auto
STORYBOOK_TTS_CONCURRENCY=4
STORYBOOK_TTS_ENGINEID=short_audio_synthesis_jovi
STORYBOOK_TTS_VOICE=yige
STORYBOOK_TTS_FALLBACK_ENGINEID=short_audio_synthesis_jovi
STORYBOOK_TTS_FALLBACK_VOICE=vivoHelper
STORYBOOK_TTS_SPEED=50
STORYBOOK_TTS_VOLUME=50
# These runtime metadata fields must match the Vivo-authorized Android package/profile.
# Leave them blank in tracked files; placeholder strings such as unknown/n/a are normalized to missing.
STORYBOOK_TTS_MODEL=
STORYBOOK_TTS_PRODUCT=
STORYBOOK_TTS_PACKAGE=
STORYBOOK_TTS_CLIENT_VERSION=
STORYBOOK_TTS_SYSTEM_VERSION=
STORYBOOK_TTS_SDK_VERSION=
STORYBOOK_TTS_ANDROID_VERSION=

# Memory backend.
# Local development can keep the repo-local SQLite path.
# VPS staging should prefer /data/agent-memory.db via backend/.env.release.
# Legacy Render staging may still override this to /tmp/agent-memory.db.
BRAIN_MEMORY_BACKEND=sqlite
MYSQL_URL=
BRAIN_MEMORY_SQLITE_PATH=backend/.local/agent-memory.db

# VPS staging recommended overrides:
# ENVIRONMENT=staging
# LOG_LEVEL=INFO
# ALLOW_ORIGINS=https://your-vercel-staging.vercel.app,https://your-frontend.example.com
# ENABLE_MOCK_PROVIDER=false
# AI_PROVIDER=maas
# AI_API_KEY=<仅注入私有运行时文件>
# BRAIN_MEMORY_BACKEND=sqlite
# BRAIN_MEMORY_SQLITE_PATH=/data/agent-memory.db
#
# Legacy Render override:
# BRAIN_MEMORY_SQLITE_PATH=/tmp/agent-memory.db
#
# Supported backend env lookup priority:
# BRAIN_ENV_FILE > backend/.env.local > repo/.env.local > backend/.env.release > repo/.env.release > backend/.env > repo/.env
